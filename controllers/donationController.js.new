// ====================================
// DONATION CONTROLLER
// ====================================

const db = require('../config/database');
const { v4: uuidv4 } = require('uuid');

class DonationController {
    async createDonation(req, res) {
        try {
            const { caseId, campaignId, amount, paymentMethod, providerReference, isAnonymous, guestName, guestEmail } = req.body;
            // If user is authenticated use their userId, otherwise null
            const isAnon = !!isAnonymous || !req.user;
            const donorId = (!isAnon && req.user && (req.user.userId || req.user.id)) ? (req.user.userId || req.user.id) : null;
            const connection = await db.getConnection();

            try {
                const donationDate = new Date();

                // If donation is for a campaign (new campaigns table), insert into PAYMENTS and update CAMPAIGNS
                if (campaignId) {
                    const paymentId = uuidv4();
                    await connection.execute(
                        `INSERT INTO PAYMENTS (payment_id, campaign_id, donor_name, donor_email, amount, provider, provider_reference, status, created_at)
                         VALUES (?, ?, ?, ?, ?, ?, ?, 'completed', ?)`,
                        [paymentId, campaignId, isAnon ? 'Anonymous' : (guestName || req.user?.name || null), isAnon ? '' : (guestEmail || req.user?.email || null), amount, paymentMethod || null, providerReference || null, donationDate]
                    );

                    // Update campaign collected amount atomically
                    await connection.execute(
                        `UPDATE CAMPAIGNS SET collected_amount = collected_amount + ? WHERE campaign_id = ?`,
                        [amount, campaignId]
                    );

                    // Upsert wallet for campaign
                    const [w] = await connection.execute('SELECT wallet_id FROM WALLETS WHERE campaign_id = ? LIMIT 1', [campaignId]);
                    if (w && w.length) {
                        await connection.execute('UPDATE WALLETS SET balance = balance + ? WHERE wallet_id = ?', [amount, w[0].wallet_id]);
                    } else {
                        const wid = uuidv4();
                        await connection.execute('INSERT INTO WALLETS (wallet_id, campaign_id, balance, created_at) VALUES (?, ?, ?, ?)', [wid, campaignId, amount, new Date()]);
                    }

                    // Fetch updated campaign totals to return to client
                    const [rows] = await connection.execute('SELECT goal_amount, collected_amount FROM CAMPAIGNS WHERE campaign_id = ?', [campaignId]);
                    const campaign = rows[0] || null;

                    return res.status(201).json({
                        success: true,
                        message: 'Donation recorded for campaign',
                        data: campaign
                    });
                }

                // Donation is for a case
                if (!caseId) {
                    return res.status(400).json({ success: false, message: 'caseId or campaignId required' });
                }

                const donationId = uuidv4();

                const [caseRows] = await connection.execute('SELECT case_id, collected_amount FROM PATIENT_CASES WHERE case_id = ?', [caseId]);
                if (!caseRows.length) {
                    return res.status(404).json({ success: false, message: 'Case not found' });
                }

                // Insert donation
                await connection.execute(
                    `INSERT INTO DONATIONS (donation_id, case_id, donor_id, amount, payment_method, donation_date, status, is_anonymous, guest_name, guest_email)
                     VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
                    [donationId, caseId, donorId, amount, paymentMethod, donationDate, 'completed', isAnon, isAnon ? null : guestName, isAnon ? null : guestEmail]
                );

                // Update case collected amount
                await connection.execute(
                    `UPDATE PATIENT_CASES SET collected_amount = collected_amount + ? WHERE case_id = ?`,
                    [amount, caseId]
                );

                // If donorId exists, update donor total_donated_amount
                if (donorId) {
                    await connection.execute(
                        `UPDATE DONORS SET total_donated_amount = COALESCE(total_donated_amount, 0) + ?, last_donation_date = ? WHERE donor_id = ?`,
                        [amount, donationDate, donorId]
                    );
                }

                // Fetch updated case totals
                const [updatedCase] = await connection.execute('SELECT goal_amount, collected_amount FROM PATIENT_CASES WHERE case_id = ?', [caseId]);

                return res.status(201).json({
                    success: true,
                    message: 'Donation successful',
                    data: {
                        donationId,
                        caseId,
                        amount,
                        case: updatedCase[0]
                    }
                });

            } finally {
                connection.release();
            }

        } catch (error) {
            console.error('Donation creation error:', error);
            res.status(500).json({ success: false, message: 'Failed to process donation', error: error.message });
        }
    }

    async getDonationsForCase(req, res) {
        try {
            const { caseId } = req.query;
            if (!caseId) {
                return res.status(400).json({ success: false, message: 'caseId required' });
            }

            const connection = await db.getConnection();
            try {
                const [donations] = await connection.execute(
                    `SELECT d.*, COALESCE(u.username, d.guest_name) as donor_name
                     FROM DONATIONS d
                     LEFT JOIN DONORS donor ON d.donor_id = donor.donor_id
                     LEFT JOIN USERS u ON donor.user_id = u.user_id
                     WHERE d.case_id = ?
                     ORDER BY d.donation_date DESC`,
                    [caseId]
                );

                res.json({
                    success: true,
                    data: donations
                });
            } finally {
                connection.release();
            }
        } catch (error) {
            console.error('Get case donations error:', error);
            res.status(500).json({ message: 'Failed to fetch donations', error: error.message });
        }
    }

    async getDonationHistory(req, res) {
        try {
            const userId = req.user?.userId || req.user?.id;
            if (!userId) {
                return res.status(401).json({ success: false, message: 'Unauthorized' });
            }

            const connection = await db.getConnection();

            try {
                // First get donor_id for this user
                const [donorRows] = await connection.execute('SELECT donor_id FROM DONORS WHERE user_id = ?', [userId]);
                if (!donorRows.length) {
                    return res.json({ success: true, data: [] });
                }

                const donorId = donorRows[0].donor_id;

                // Get all donations for this donor
                const [donations] = await connection.execute(
                    `SELECT d.*, pc.case_title
                     FROM DONATIONS d
                     JOIN PATIENT_CASES pc ON d.case_id = pc.case_id
                     WHERE d.donor_id = ?
                     ORDER BY d.donation_date DESC`,
                    [donorId]
                );

                res.json({
                    success: true,
                    data: donations
                });

            } finally {
                connection.release();
            }

        } catch (error) {
            console.error('Get donation history error:', error);
            res.status(500).json({ message: 'Failed to fetch donation history', error: error.message });
        }
    }

    async sendThankYouMessage(req, res) {
        try {
            const { donationId } = req.params;
            const { message } = req.body;
            const userId = req.user?.userId || req.user?.id;

            if (!userId) {
                return res.status(401).json({ success: false, message: 'Unauthorized' });
            }

            const connection = await db.getConnection();

            try {
                // Verify this donation belongs to a case owned by this patient
                const [donRows] = await connection.execute(`
                    SELECT d.donation_id, d.case_id, pc.patient_id, p.user_id
                    FROM DONATIONS d
                    JOIN PATIENT_CASES pc ON d.case_id = pc.case_id
                    JOIN PATIENTS p ON pc.patient_id = p.patient_id
                    WHERE d.donation_id = ?
                `, [donationId]);

                if (!donRows.length) {
                    return res.status(404).json({ success: false, message: 'Donation not found' });
                }

                if (donRows[0].user_id !== userId) {
                    return res.status(403).json({ success: false, message: 'Forbidden' });
                }

                // Log thank you message (optional: can store in database if needed)
                console.log(`Thank you message from patient ${userId} for donation ${donationId}: ${message}`);

                res.json({ success: true, message: 'Thank you message sent to donor!' });

            } finally {
                connection.release();
            }

        } catch (error) {
            console.error('Send thank you error:', error);
            res.status(500).json({ message: 'Failed to send thank you message', error: error.message });
        }
    }
}

module.exports = new DonationController();
